# Kopyalayıp .env olarak kaydedin: cp env.example .env
# Sonra aşağıdaki değerleri kendi bilgilerinizle doldurun.

# WhatsApp Cloud API (Meta Developer Console'dan alın)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=sigorta-verify-token
# Sunucunuz dışarıdan erişilebilirse (ngrok vb.) webhook için:
# BASE_URL=https://abc123.ngrok.io

# Ruhsat görsel analizi için OpenAI API (https://platform.openai.com/api-keys)
# Tanımlı değilse ruhsat bilgileri otomatik okunmaz
OPENAI_API_KEY=
# true/1 yaparsanız WhatsApp'a atılan her ruhsat fotoğrafında API çağrılır. Yoksa sadece admin panelde "Ruhsattan tekrar oku" ile çağrılır (tasarruf için).
# RUHSAT_AI_ON_PHOTO=true

# Sunucu
PORT=3000

# Admin panel girişi (güçlü şifre kullanın)
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_SECRET=
